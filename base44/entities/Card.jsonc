{
  "name": "Card",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "doctor",
        "school",
        "store",
        "work",
        "conversation"
      ],
      "description": "Learning category"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the illustration image"
    },
    "sentence": {
      "type": "string",
      "description": "English sentence to learn"
    },
    "keyword": {
      "type": "string",
      "description": "The key word being taught"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order within category"
    }
  },
  "required": [
    "category",
    "sentence",
    "keyword"
  ]
}